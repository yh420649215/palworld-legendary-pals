---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ShareButtons from '../../modules/seo/ShareButtons.astro';
import AdSlot from '../../modules/ads/AdSlot.astro';

export async function getStaticPaths() {
  const pals = await getCollection('pals');
  return pals.map((pal) => ({
    params: { slug: pal.slug }, // Astro auto-generates slug from filename
    props: { pal },
  }));
}

const { pal } = Astro.props;
const allPals = await getCollection('pals');
const { Content } = await pal.render();

// FAQ items for structured data
const faqData: Record<string, Array<{ question: string; answer: string }>> = {
  'jetragon': [
    {
      question: 'What is Jetragon weak to?',
      answer: 'Jetragon is a Dragon-type Pal, making it weak to Ice-type attacks. Ice attacks deal 2× damage to Jetragon, while Ice Pals take only 0.5× damage from Dragon attacks in return. The best counter Pals are Frostallion, Reindrix, and Chillet. Avoid bringing Fire, Water, Electric, or Grass Pals — Dragon resists all four at 0.5× damage.'
    },
    {
      question: 'Where does Jetragon spawn?',
      answer: 'Jetragon spawns as a Level 70 Alpha Pal in the Sunreach area at coordinates (-553, -1332). This is a late-game area in Palworld 1.0. It is only found as an Alpha Pal and is aggressive — it will attack on sight.'
    }
  ],
  'frostallion': [
    {
      question: 'What is Frostallion weak to?',
      answer: 'Frostallion is an Ice-type Pal, making it weak to Fire-type attacks. Fire attacks deal 2× damage to Frostallion, and Fire Pals take only 0.5× damage from Ice attacks. The best counter Pals are Jormuntide Ignis, Blazamut, and Suzaku. Avoid bringing Ice Pals — Ice resists Ice at 0.5× damage.'
    },
    {
      question: 'Where does Frostallion spawn?',
      answer: 'Frostallion spawns as a Level 60 Alpha Pal in the Astral Mountains region at coordinates (-357, 509) in the northwest of the map. It is only found as an Alpha Pal and is aggressive — it will attack on sight. The Alpha respawns after a few in-game days.'
    }
  ],
  'frostallion-noct': [
    {
      question: 'What is Frostallion Noct weak to?',
      answer: 'Frostallion Noct is a Dark-type Pal, making it weak to Dragon-type attacks. Dragon attacks deal 2× damage to Frostallion Noct, and Dragon Pals take only 0.5× damage from Dark attacks. The best counter Pals are Jetragon, Quivern, and Relaxaurus. Avoid bringing Normal or Dark Pals — Dark resists both at 0.5× damage.'
    },
    {
      question: 'Where does Frostallion Noct spawn?',
      answer: 'Frostallion Noct spawns as a Level 65 Alpha Pal at the No. 3 Wildlife Sanctuary at coordinates (689, 648) in the northeastern ocean of Palworld 1.0. Since version 0.4.11.0, it has its own Alpha spawn. Prior to that, it could only be obtained through breeding Frostallion + Helzephyr.'
    }
  ],
  'necromus': [
    {
      question: 'What is Necromus weak to?',
      answer: 'Necromus is a Dark-type Pal, making it weak to Dragon-type attacks. Dragon attacks deal 2× damage to Necromus, and Dragon Pals take only 0.5× damage from Dark attacks. The best counter Pals are Jetragon, Quivern, and Relaxaurus. Avoid bringing Normal or Dark Pals — Dark resists both at 0.5×. Be careful: Necromus spawns alongside Paladius, so you may fight both at once.'
    },
    {
      question: 'Where does Necromus spawn?',
      answer: 'Necromus spawns as a Level 60 Alpha Pal in the Desiccated Desert at coordinates (447, 679) in the northeastern part of the map. It roams the desert alongside Paladius and spawns during both day and night. It is aggressive, does not sleep (Dark-type), and respawns after about an hour of real time.'
    }
  ],
  'paladius': [
    {
      question: 'What is Paladius weak to?',
      answer: 'Paladius is a Neutral-type Pal and has no elemental weaknesses — no type deals extra damage against it. All attacks hit for the standard 1× damage. The best strategy is to bring your highest Attack Pals like Jetragon, Jormuntide Ignis, or Blazamut and focus on raw damage output. Avoid bringing low-level or under-geared Pals — this is a stat-check fight against Paladius\'s 145 base Defense.'
    },
    {
      question: 'Where does Paladius spawn?',
      answer: 'Paladius spawns as a Level 60 Alpha Pal in the Desiccated Desert at coordinates (447, 679) in the northeastern part of the map. It roams the desert alongside Necromus and is aggressive — it will attack on sight. It respawns after about an hour of real time if killed or captured.'
    }
  ],
  'neptilius': [
    {
      question: 'What is Neptilius weak to?',
      answer: 'Neptilius is a Water-type Pal, making it weak to Electric and Grass-type attacks. Both types deal 2× damage to Neptilius, and Electric/Grass Pals take only 0.5× damage from Water attacks. The best counter Pals are Grizzbolt (Electric), Verdash (Grass), and Jolthog (Electric). Avoid bringing Fire or Water Pals — Water resists both at 0.5× damage.'
    },
    {
      question: 'Where does Neptilius spawn?',
      answer: 'Neptilius spawns as a Level 60 Alpha Pal on the Isle of the Glacial Core at coordinates (139, 651) in the northern waters of Palworld 1.0. It was added in version 0.6.0. You\'ll need cold-resistant gear and high-level Pals — this is a late-game area with freezing temperatures.'
    }
  ]
};

const faqItems = faqData[pal.slug] || [];
---

<BaseLayout
  title={`${pal.data.name} Location & Capture Guide — Palworld 1.0 (Map & Coordinates)`}
  description={(() => {
    const descs = {
      'jetragon': "Find and capture Jetragon, the legendary Dragon-type Pal, at Sunreach (-553, -1332) in Palworld 1.0. Complete location guide with stats, drops, breeding tips, and the best strategy to catch this fast flying mount.",
      'frostallion': "Locate and capture Frostallion in the Astral Mountains (-357, 509) in Palworld 1.0. Full guide to the legendary Ice-type Pal: spawn location, catch strategy, base stats, drops, partner skill, and breeding tips.",
      'frostallion-noct': "Where to find Frostallion Noct at No. 3 Wildlife Sanctuary (689, 648) or Sealed Realm in Palworld 1.0. The only legendary Dark-type Pal — catch guide, stats, breed combo with Helzephyr, and strategy.",
      'necromus': "How to find and catch Necromus in the Desiccated Desert (447, 679) in Palworld 1.0. Full guide to this legendary Dark-type ground mount with stats, drops, partner skill, and capture strategy.",
      'paladius': "Locate and capture Paladius in the Desiccated Desert (447, 679) in Palworld 1.0. Complete guide to the legendary Neutral-type tank Pal: stats, Pal Metal Ingot drops, partner skill, and catch tips.",
      'neptilius': "Where to find Neptilius on the Isle of the Glacial Core (139, 651) in Palworld 1.0. Guide to catching the legendary Water-type: spawn location, stats, drops, weakness, and capture strategy.",
    };
    return descs[pal.slug] || `Where to find ${pal.data.name} in Palworld 1.0. Legendary ${pal.data.type} Pal location, capture strategy, stats, drops, and partner skill.`
  })()}
  ogImage={`/images/${pal.slug}.webp`}
  faqItems={faqItems}
>
  <article class="max-w-3xl mx-auto">
    <div class="flex items-center gap-3 mb-8">
      <span class="bg-[#3ecf8e]/20 text-[#3ecf8e] text-xs px-3 py-1 rounded-full font-medium">
        {pal.data.type}
      </span>
      <span class="text-sm text-[#898989] font-medium">Legendary &middot; Lv. {pal.data.level}</span>
    </div>

    <h1 class="text-4xl font-normal mb-3" style="letter-spacing: -0.02em;">
      {pal.data.name}
    </h1>

    <div class="w-full h-64 bg-[#141414] border border-[#2e2e2e] rounded-xl overflow-hidden mb-8">
      <img
        src={`/images/${pal.slug}.webp`}
        alt={pal.data.name}
        class="w-full h-full object-contain"
        onerror="this.src='/images/placeholder.svg'"
        loading="eager"
      />
    </div>

    <p class="text-lg text-[#b4b4b4] mb-6 leading-relaxed">
      Complete guide to finding and capturing {pal.data.name} in Palworld 1.0. Location, stats, drops, and strategy.
    </p>

    <div class="mb-8">
      <ShareButtons title={`${pal.data.name} Location & Capture Guide — Palworld 1.0`} />
    </div>

    <div class="prose prose-invert max-w-none
      prose-h2:text-2xl prose-h2:font-normal prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-[#2e2e2e]
      prose-p:text-[#b4b4b4] prose-p:leading-relaxed
      prose-strong:text-[#fafafa]
      prose-li:text-[#b4b4b4] prose-li:leading-relaxed
      prose-code:text-[#3ecf8e] prose-code:bg-[#1a1a1a] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
      prose-table:rounded-lg prose-table:overflow-hidden
      prose-th:bg-[#1a1a1a] prose-th:text-[#898989] prose-th:text-xs prose-th:font-medium prose-th:uppercase prose-th:tracking-wider prose-th:px-4 prose-th:py-3
      prose-td:text-[#fafafa] prose-td:px-4 prose-td:py-3 prose-td:bg-[#171717] prose-td:border-b prose-td:border-[#2e2e2e]
      prose-hr:border-[#2e2e2e]
      prose-a:text-[#00c573] prose-a:no-underline hover:prose-a:underline">
      <Content />
    </div>

    <!-- Related Legendary Pals cross-links -->
    <section class="mt-16 pt-10 border-t border-[#2e2e2e]">
      <h2 class="text-xl font-normal text-[#fafafa] mb-6">Related Legendary Pals</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {allPals
          .filter(p => p.slug !== pal.slug)
          .map(p => (
            <a
              href={`/pals/${p.slug}/`}
              class="flex items-center gap-3 bg-[#1a1a1a] border border-[#2e2e2e] rounded-lg p-3 hover:border-[#3ecf8e]/30 hover:bg-[#1e1e1e] transition-all group"
            >
              <img
                src={`/images/${p.slug}.webp`}
                alt={p.data.name}
                class="w-10 h-10 rounded object-contain bg-[#141414] shrink-0"
                loading="lazy"
                onerror="this.style.display='none'"
              />
              <div class="min-w-0">
                <p class="text-sm font-medium text-[#fafafa] group-hover:text-[#3ecf8e] transition-colors truncate">
                  {p.data.name}
                </p>
                <p class="text-xs text-[#898989]">{p.data.type} &middot; Lv. {p.data.level}</p>
              </div>
            </a>
          ))
        }
      </div>
      <div class="mt-6 flex gap-3 text-sm">
        <a href="/pals/" class="text-[#00c573] hover:underline font-medium">← All Legendary Pals</a>
        <a href="/best-legendary-pals/" class="text-[#00c573] hover:underline">Tier List</a>
        <a href="/breeding-cheat-sheet/" class="text-[#00c573] hover:underline">Breeding Cheat Sheet</a>
        <a href="/breeding-how-to/" class="text-[#00c573] hover:underline">Speed Breeding Guide</a>
      </div>
    </section>
  </article>
</BaseLayout>
