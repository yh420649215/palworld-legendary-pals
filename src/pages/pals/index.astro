---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const pals = await getCollection('pals');

const typeColors: Record<string, string> = {
  Dragon: 'border-[#3ecf8e]/30 bg-[#3ecf8e]/10 text-[#3ecf8e]',
  Ice: 'border-[#7dd3fc]/30 bg-[#7dd3fc]/10 text-[#7dd3fc]',
  Dark: 'border-[#a78bfa]/30 bg-[#a78bfa]/10 text-[#a78bfa]',
  Neutral: 'border-[#facc15]/30 bg-[#facc15]/10 text-[#facc15]',
  Water: 'border-[#38bdf8]/30 bg-[#38bdf8]/10 text-[#38bdf8]',
};
---

<BaseLayout
  title="All Legendary Pals — Palworld 1.0"
  description="Browse all 6 Legendary Pals in Palworld 1.0. Click any Pal for the full location guide, capture strategy, stats, and drops."
>
  <section class="text-center mb-12">
    <h1 class="text-3xl font-semibold mb-3 tracking-tight">
      All <span class="text-[#3ecf8e]">Legendary Pals</span>
    </h1>
    <p class="text-[#898989]">{pals.length} Legendary Pals in Palworld 1.0</p>
  </section>

  <!-- Highlighted: Speed Breeding Guide -->
  <a href="/breeding-how-to/" class="block mb-4 bg-[#1a1a1a] border border-[#3ecf8e]/30 rounded-xl p-5 hover:border-[#3ecf8e]/60 transition-colors group relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-[#3ecf8e]/5 to-transparent"></div>
    <div class="flex items-center gap-3 relative">
      <span class="text-[#3ecf8e] text-lg shrink-0">⚡</span>
      <div>
        <p class="text-sm font-semibold text-[#fafafa] group-hover:text-[#3ecf8e] transition-colors">Speed Breeding Guide →</p>
        <p class="text-xs text-[#898989] leading-relaxed">Step-by-step speed breeding: inherit Swift, Runner &amp; Legend onto your mounts</p>
      </div>
    </div>
  </a>

  <a href="/breeding-cheat-sheet/" class="block mb-10 bg-[#1a1a1a] border border-[#2e2e2e] rounded-xl p-5 hover:border-[#3ecf8e]/20 transition-colors group">
    <div class="flex items-center gap-3">
      <span class="text-[#3ecf8e] text-lg shrink-0">🥚</span>
      <div>
        <p class="text-sm font-semibold text-[#fafafa] group-hover:text-[#3ecf8e] transition-colors">Breeding Cheat Sheet →</p>
        <p class="text-xs text-[#898989] leading-relaxed">All 6 legendary breeding rules, breed power, and exclusive passives in one table</p>
      </div>
    </div>
  </a>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      pals.map((pal) => (
        <a
          href={`/pals/${pal.slug}`}
          class="group block bg-[#1a1a1a] border border-[#2e2e2e] rounded-xl overflow-hidden
                 hover:border-[#3ecf8e]/30 hover:bg-[#1e1e1e] transition-all duration-200"
        >
          <div class="h-44 bg-[#141414] flex items-center justify-center overflow-hidden">
            <img
              src={`/images/${pal.slug}.webp`}
              alt={pal.data.name}
              class="w-full h-full object-contain opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300"
              onerror="this.src='/images/placeholder.svg'"
              loading="lazy"
            />
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2 mb-3">
              <span class={`text-xs px-2.5 py-1 rounded-full border font-medium ${typeColors[pal.data.type] || 'border-[#2e2e2e] bg-[#1a1a1a] text-[#898989]'}`}>
                {pal.data.type}
              </span>
              <span class="text-xs text-[#62666d] font-medium">Lv. {pal.data.level}</span>
            </div>
            <h2 class="text-lg font-semibold text-[#fafafa] group-hover:text-[#3ecf8e] transition-colors">
              {pal.data.name}
            </h2>
            <p class="text-sm text-[#898989] mt-1.5 leading-relaxed">
              Location, capture strategy &amp; full stats
            </p>
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
