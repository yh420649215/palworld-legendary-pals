---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareButtons from '../modules/seo/ShareButtons.astro';

const typeColors: Record<string, string> = {
  Dragon: 'border-[#3ecf8e]/30 bg-[#3ecf8e]/10 text-[#3ecf8e]',
  Ice: 'border-[#7dd3fc]/30 bg-[#7dd3fc]/10 text-[#7dd3fc]',
  Dark: 'border-[#a78bfa]/30 bg-[#a78bfa]/10 text-[#a78bfa]',
  Neutral: 'border-[#facc15]/30 bg-[#facc15]/10 text-[#facc15]',
  Water: 'border-[#38bdf8]/30 bg-[#38bdf8]/10 text-[#38bdf8]',
};

const pals = [
  {
    name: 'Jetragon',
    slug: 'jetragon',
    type: 'Dragon',
    breedPower: 90,
    breedingRule: 'Jetragon + Jetragon',
    exclusivePassives: 'Legend, Divine Dragon',
    partnerSkill: 'Aerial Missile',
    hatchTime: '~2h (Huge Dragon Egg)',
  },
  {
    name: 'Frostallion',
    slug: 'frostallion',
    type: 'Ice',
    breedPower: 120,
    breedingRule: 'Frostallion + Frostallion',
    exclusivePassives: 'Legend, Ice Emperor',
    partnerSkill: 'Ice Steed',
    hatchTime: '~2h (Huge Frozen Egg)',
  },
  {
    name: 'Frostallion Noct',
    slug: 'frostallion-noct',
    type: 'Dark',
    breedPower: 100,
    breedingRule: 'Frostallion + Helzephyr',
    exclusivePassives: 'Legend, Lord of the Underworld',
    partnerSkill: 'Black Steed',
    hatchTime: '~2h (Huge Dark Egg)',
  },
  {
    name: 'Necromus',
    slug: 'necromus',
    type: 'Dark',
    breedPower: 70,
    breedingRule: 'Necromus + Necromus',
    exclusivePassives: 'Legend, Lord of the Underworld',
    partnerSkill: 'Dark Knight of the Abyss',
    hatchTime: '~2h (Huge Dark Egg)',
  },
  {
    name: 'Paladius',
    slug: 'paladius',
    type: 'Neutral',
    breedPower: 80,
    breedingRule: 'Paladius + Paladius',
    exclusivePassives: 'Legend, Celestial Emperor',
    partnerSkill: 'Holy Knight of the Firmament',
    hatchTime: '~2h (Huge Common Egg)',
  },
  {
    name: 'Neptilius',
    slug: 'neptilius',
    type: 'Water',
    breedPower: 90,
    breedingRule: 'Neptilius + Neptilius',
    exclusivePassives: 'Legend, Lunker',
    partnerSkill: 'Sentinel of the Great Sea',
    hatchTime: '~2h (Huge Damp Egg)',
  },
];
---

<BaseLayout
  title="Legendary Pal Breeding Cheat Sheet — Palworld 1.0"
  description="Quick reference table for all 6 legendary Pal breeding rules, breed power, exclusive passives, and partner skills."
>
  <section class="mb-10">
    <div class="flex items-baseline justify-between flex-wrap gap-2 mb-2">
      <h1 class="text-2xl font-normal tracking-tight">
        Legendary Pal <span class="text-[#3ecf8e]">Breeding</span> Cheat Sheet
      </h1>
      <div class="flex items-center gap-2 text-xs font-medium">
        <span class="border border-[#3ecf8e]/20 bg-[#3ecf8e]/10 text-[#3ecf8e] px-2.5 py-1 rounded-full">Palworld 1.0</span>
        <span class="border border-[#2e2e2e] bg-[#1a1a1a] text-[#898989] px-2.5 py-1 rounded-full">6 Legendary Pals</span>
      </div>
    </div>
    <p class="text-sm text-[#898989] leading-relaxed">
      All 6 legendary Pal breeding data in one table. Save this — it's the only reference you'll need.
    </p>
  </section>

  <!-- TABLE -->
  <div class="overflow-x-auto rounded-xl border border-[#2e2e2e] bg-[#1a1a1a]">
    <table class="w-full text-sm text-left border-collapse">
      <thead>
        <tr class="bg-[#3ecf8e] text-[#0a0a0a]">
          <th class="px-4 py-3 font-semibold text-xs uppercase tracking-wider whitespace-nowrap">Pal</th>
          <th class="px-4 py-3 font-semibold text-xs uppercase tracking-wider whitespace-nowrap">Type</th>
          <th class="px-4 py-3 font-semibold text-xs uppercase tracking-wider whitespace-nowrap">Breed Power</th>
          <th class="px-4 py-3 font-semibold text-xs uppercase tracking-wider whitespace-nowrap">Breeding Rule</th>
          <th class="px-4 py-3 font-semibold text-xs uppercase tracking-wider whitespace-nowrap">Exclusive Passives</th>
          <th class="px-4 py-3 font-semibold text-xs uppercase tracking-wider whitespace-nowrap">Partner Skill</th>
          <th class="px-4 py-3 font-semibold text-xs uppercase tracking-wider whitespace-nowrap">Hatch Time</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#2e2e2e]">
        {
          pals.map((pal, i) => (
            <tr class={`${i % 2 === 0 ? 'bg-[#1a1a1a]' : 'bg-[#1e1e1e]'} hover:bg-[#252525] transition-colors`}>
              <td class="px-4 py-3 font-medium text-[#fafafa] whitespace-nowrap">
                <div class="flex items-center gap-2">
                  <img
                    src={`/images/${pal.slug}.webp`}
                    alt={pal.name}
                    class="w-8 h-8 rounded object-contain bg-[#141414]"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                  <span>{pal.name}</span>
                  {pal.name === 'Frostallion Noct' && (
                    <span class="text-[10px] text-[#3ecf8e] bg-[#3ecf8e]/10 px-1.5 py-0.5 rounded whitespace-nowrap ml-1">SPECIAL</span>
                  )}
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <span class={`text-xs px-2.5 py-1 rounded-full border font-medium ${typeColors[pal.type] || 'border-[#2e2e2e] bg-[#1a1a1a] text-[#898989]'}`}>
                  {pal.type}
                </span>
              </td>
              <td class="px-4 py-3 text-[#fafafa] font-mono text-sm font-semibold whitespace-nowrap">
                {pal.breedPower > 100 ? (
                  <span class="text-[#3ecf8e]">{pal.breedPower}</span>
                ) : pal.breedPower >= 90 ? (
                  <span>{pal.breedPower}</span>
                ) : (
                  <span class="text-[#898989]">{pal.breedPower}</span>
                )}
              </td>
              <td class="px-4 py-3 text-[#b4b4b4] text-xs leading-relaxed min-w-[180px]">
                <code class="text-[#3ecf8e] bg-[#0a0a0a] px-1.5 py-0.5 rounded text-xs">{pal.breedingRule}</code>
              </td>
              <td class="px-4 py-3 text-[#b4b4b4] text-xs leading-relaxed min-w-[160px]">{pal.exclusivePassives}</td>
              <td class="px-4 py-3 text-[#fafafa] text-xs font-medium whitespace-nowrap">{pal.partnerSkill}</td>
              <td class="px-4 py-3 text-[#898989] text-xs whitespace-nowrap">{pal.hatchTime}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <!-- FROSTALLION NOCT NOTE -->
  <!-- Accent-rail callout: intentional brand design element -->
  <div class="mt-6 bg-[#1a1a1a] border-l-2 border-[#3ecf8e] rounded-r-lg p-5">
    <div>
      <p class="text-sm text-[#fafafa] font-semibold mb-1">
        Frostallion Noct is the ONLY legendary that breaks the same-species rule.
      </p>
      <p class="text-xs text-[#b4b4b4] leading-relaxed">
        Every other legendary requires two of the same Pal to breed. Frostallion Noct is unique — you must pair a
        <span class="text-[#7dd3fc]">Frostallion</span> with a
        <span class="text-[#a78bfa]">Helzephyr</span> to produce it. Two Frostallion Nocts cannot breed together.
        This also means Frostallion Noct can inherit the <span class="text-[#3ecf8e]">Lucky</span> passive from the Helzephyr parent — the only legendary that can hatch with Lucky naturally.
      </p>
    </div>
  </div>

  <!-- SHARE SECTION -->
  <div class="mt-10 bg-[#1a1a1a] border border-[#2e2e2e] rounded-xl p-8 text-center">
    <h2 class="text-lg font-normal mb-2">Found this useful?</h2>
    <p class="text-sm text-[#898989] mb-5">Share it with your Palworld crew.</p>
    <div class="flex justify-center">
      <ShareButtons title="Legendary Pal Breeding Cheat Sheet — Palworld 1.0" />
    </div>
    <p class="text-[10px] text-[#4d4d4d] mt-4">Bookmark this page. Screenshot it. Post it on Reddit. We don't mind.</p>
  </div>

  <!-- NEXT: SPEED BREEDING GUIDE -->
  <div class="mt-8 bg-[#0d0d0d] border border-[#3ecf8e]/30 rounded-xl p-6 hover:border-[#3ecf8e]/50 transition-colors group">
    <a href="/breeding-how-to/" class="block no-underline">
      <div class="flex items-center gap-3 mb-3">
        <span class="text-[#3ecf8e] text-xl shrink-0"></span>
        <p class="text-base font-semibold text-[#fafafa] group-hover:text-[#3ecf8e] transition-colors">Next: Speed Breeding Guide →</p>
      </div>
      <p class="text-sm text-[#b4b4b4] leading-relaxed">
        Got the breeding rules down? Learn how to breed the fastest legendary mounts. Step-by-step builds for Jetragon, Frostallion, Necromus &amp; more — passive inheritance, Philanthropist strategy, 175% speed stacks.
      </p>
    </a>
  </div>

  <!-- QUICK REFERENCE — prioritized, not equal-weight -->
  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div class="bg-[#0d0d0d] border border-[#3ecf8e]/20 rounded-lg p-4">
      <p class="text-sm font-semibold text-[#fafafa] mb-1"> Frostallion Noct is the only exception</p>
      <p class="text-xs text-[#898989] leading-relaxed">Only legendary that breaks same-species rule. Must pair <span class="text-[#7dd3fc]">Frostallion</span> + <span class="text-[#a78bfa]">Helzephyr</span>. Lucky passive can be inherited.</p>
    </div>
    <div class="bg-[#0d0d0d] border border-[#2e2e2e] rounded-lg p-4">
      <p class="text-sm font-semibold text-[#fafafa] mb-1">5 of 6 are same-species only</p>
      <p class="text-xs text-[#898989] leading-relaxed">All eggs hatch in ~2 hours. Highest breed power: Frostallion (120). All share <span class="text-[#3ecf8e]">Legend</span> passive.</p>
    </div>
  </div>
</BaseLayout>
